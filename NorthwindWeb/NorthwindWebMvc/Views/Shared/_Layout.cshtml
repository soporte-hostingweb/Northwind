<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          integrity="sha384-tViUnnbYAV00FLIhhi3v/dWt3Jxw4gZQcNoSCxCIFNJVCx7/D55/wXsrNIRANwdD"
          crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/crud.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home/index.css" asp-append-version="true" />
</head>
<body>
    @if (Context.Session.GetString("AdminOriginalUsuario") != null)
    {
        <div class="alert alert-warning text-center m-0 rounded-0 py-2 d-flex align-items-center justify-content-center" style="z-index: 1050; position: relative;">
            <span class="me-3">
                <i class="bi bi-exclamation-triangle-fill"></i> 
                Estás visualizando la web como el cliente <strong>@Context.Session.GetString("usuario")</strong>.
            </span>
            <a class="btn btn-sm btn-dark" href="@Url.Action("StopImpersonating", "Account")">Volver a Admin</a>
        </div>
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Northwind Management</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Product" asp-action="Index">Productos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Customer" asp-action="Index">Clientes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Shipper" asp-action="Index">Transportistas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Supplier" asp-action="Index">Proveedores</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="consultasDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Consultas</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="ProductGrpc" asp-action="FindBySupplier">Productos por proveedor</a></li>
                                <li><a class="dropdown-item" asp-controller="OrderGrpc" asp-action="BetweenDates">Pedidos entre fechas</a></li>
                                <li><a class="dropdown-item" asp-controller="OrderGrpc" asp-action="FindByCustomer">Pedidos por cliente</a></li>
                                <li><a class="dropdown-item" asp-controller="ProductGrpc" asp-action="FindByCategory">Productos por categoría</a></li>
                            </ul>
                        </li>
                        @if (Context.Session.GetString("usuario") != null)
                        {
                            <li class="nav-item dropdown ms-lg-3">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2" href="#" id="userDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span>@Context.Session.GetString("usuario")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li>
                                        <h6 class="dropdown-header">Rol: @(Context.Session.GetString("rol") ?? "Usuario")</h6>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Home" asp-action="Privacy">
                                            <i class="bi bi-gear me-2"></i> Configuración
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-outline-light btn-sm px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="text-center">
        <div class="container">
            <div class="social-icons mb-3">
                <a href="#"><i class="bi bi-facebook"></i></a>
                <a href="#"><i class="bi bi-twitter-x"></i></a>
                <a href="#"><i class="bi bi-linkedin"></i></a>
                <a href="#"><i class="bi bi-github"></i></a>
            </div>
            <p>© 2025 <strong>Northwind Web</strong> — Curso Desarrollo de Servicios Web I</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/home/index.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
